# consul_ai 用（Basic認証なし）
# AuthUserFile のパスが無いと Apache が 500 になるため入れない

# 秘匿ファイルは直接アクセス不可
<FilesMatch "^(\.htpasswd|\.htaccess|\.env|api-proxy-config\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
