AuthUserFile /home/spica8217/spica8217.xsrv.jp/public_html/api-chat/.htpasswd
AuthName "hogehoge"
AuthType Basic
require valid-user

# 秘匿ファイルは直接アクセス不可
<FilesMatch "^(\.htpasswd|\.htaccess|\.env|api-proxy-config\.php)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# プロンプト・知識データ等のサーバー専用ディレクトリは公開しない
RewriteEngine On
RewriteRule ^(api|data|node_modules|supabase)(/|$) - [F,L]
